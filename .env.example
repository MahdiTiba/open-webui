# aloGPT
WEBUI_NAME=aloGPT
WEBUI_URL=http://localhost:3000
WEBUI_SECRET_KEY=change-me-open-webui-secret-key
JWT_EXPIRES_IN=48h

# Persian UI + open access
DEFAULT_LOCALE=fa-IR
DEFAULT_USER_ROLE=user
ENABLE_PERSISTENT_CONFIG=false

# Phone OTP via alogpt-backend OIDC
ENABLE_PASSWORD_AUTH=false
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_CHANGE_FORM=false
ENABLE_SIGNUP=false
ENABLE_OAUTH=true
ENABLE_OAUTH_SIGNUP=true
OAUTH_AUTO_REDIRECT=true
OAUTH_PROVIDER_NAME=تلفن
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=change-me-open-webui-client-secret
OPENID_PROVIDER_URL=http://auth.localhost:8000/o/.well-known/openid-configuration
OPENID_REDIRECT_URI=http://localhost:3000/oauth/oidc/callback
OAUTH_SCOPES=openid email profile phone
ENABLE_OAUTH_EMAIL_FALLBACK=true
ENABLE_OAUTH_PERSISTENT_CONFIG=false
ENABLE_OAUTH_GROUP_MANAGEMENT=true
ENABLE_OAUTH_GROUP_CREATION=true
OAUTH_GROUPS_CLAIM=groups
OAUTH_GROUP_DEFAULT_SHARE=false
OPENID_END_SESSION_ENDPOINT=http://auth.localhost:8000/accounts/logout/
WEBUI_AUTH_SIGNOUT_REDIRECT_URL=http://auth.localhost:8000/accounts/logout/

OLLAMA_BASE_URL=
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
CORS_ALLOW_ORIGIN=*
ENABLE_MEMORY_SYSTEM_CONTEXT=true
ENABLE_PLUGINS=true
FORWARDED_ALLOW_IPS=*
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
